{
  "version": 2,
  "builds": [
    { "src": "api/create-order.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "^/api/create-order$",
      "dest": "/api/create-order.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
